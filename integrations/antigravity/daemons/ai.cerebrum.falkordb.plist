<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.cerebrum.falkordb</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/redis-server</string>
        <string>/Users/rb/.cerebrum/config/falkordb.conf</string>
        <string>--daemonize</string>
        <string>no</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/rb/.cerebrum/logs/falkordb_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rb/.cerebrum/logs/falkordb_stderr.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/rb/.cerebrum</string>
</dict>
</plist>
