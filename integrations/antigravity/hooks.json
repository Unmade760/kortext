{
  "kortext-ambient-grounding": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "sh \"${KORTEXT_PLUGIN_DIR:-$HOME/.gemini/config/plugins/kortext}/run_hook.sh\" pre_invoke",
        "timeout": 5
      }
    ]
  },
  "kortext-runaway-guard": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "sh \"${KORTEXT_PLUGIN_DIR:-$HOME/.gemini/config/plugins/kortext}/run_hook.sh\" post_invoke",
        "timeout": 5
      }
    ]
  },
  "kortext-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "(client:|mcp[:_]+kortext[:_]+|kortext:)?(run_command|grep_search|find_by_name|view_file|replace_file_content|multi_replace_file_content|write_to_file)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${KORTEXT_PLUGIN_DIR:-$HOME/.gemini/config/plugins/kortext}/run_hook.sh\" pre_tool",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "kortext-cache-invalidation": {
    "PostToolUse": [
      {
        "matcher": "(client:|mcp[:_]+kortext[:_]+|kortext:)?(run_command|write_to_file|replace_file_content|multi_replace_file_content|seek_symbol|trace_symbol_impact|manage_tasks|record_system_outcome)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${KORTEXT_PLUGIN_DIR:-$HOME/.gemini/config/plugins/kortext}/run_hook.sh\" post_tool",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "kortext-dag-stop-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "sh \"${KORTEXT_PLUGIN_DIR:-$HOME/.gemini/config/plugins/kortext}/run_hook.sh\" stop",
        "timeout": 15
      }
    ]
  }
}