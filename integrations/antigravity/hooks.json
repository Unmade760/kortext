{
  "kortext-ambient-grounding": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "/Users/rb/kortext/.venv/bin/python3 -m kortext.hooks.runner pre_invoke",
        "timeout": 15
      }
    ]
  },
  "kortext-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rb/kortext/.venv/bin/python3 -m kortext.hooks.runner pre_tool",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "kortext-cache-invalidation": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rb/kortext/.venv/bin/python3 -m kortext.hooks.runner post_tool",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "kortext-dag-stop-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "/Users/rb/kortext/.venv/bin/python3 -m kortext.hooks.runner stop",
        "timeout": 15
      }
    ]
  }
}